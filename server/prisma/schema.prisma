datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  user
  provider
  admin
}

enum ExploreCategoryId {
  academics
  tech_creative
  media
  business_career
  campus_lifestyle
}

enum NotificationKind {
  message
  service
  request
  system
}

enum MessageKind {
  text
  system
}

model Category {
  id          ExploreCategoryId @id
  title       String
  pillLabel   String
  tagline     String
  description String
  imageUrl    String
  accentColor String
  iconName    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  services CategoryService[]
  users    User[]

  @@map("categories")
}

model CategoryService {
  id          String            @id @default(uuid())
  categoryId  ExploreCategoryId
  title       String
  description String
  filterTags  String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_services")
}

enum ReportTargetType {
  user
  post
}

enum ReportReason {
  spam
  harassment
  inappropriate_content
  scam
  other
}

enum ReportStatus {
  pending
  reviewed
  dismissed
  actioned
}

enum PostStatus {
  active
  hidden_by_owner
  removed_by_admin
}

enum UserStatus {
  active
  suspended
  banned
}

model User {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  username      String             @unique
  password      String
  role          UserRole           @default(user)
  status        UserStatus         @default(active)
  avatarUrl     String             @default("")
  bio           String             @default("")
  categoryId    ExploreCategoryId?
  skillTitle    String?
  expertiseTags String[]
  serviceIds    String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  lastLoginAt   DateTime?
  otpCode       String?
  otpExpires    DateTime?
  pushToken     String?            @map("push_token")

  // Relations
  posts               Post[]
  sentMessages        ChatMessage[]        @relation("SentMessages")
  receivedMessages    ChatMessage[]        @relation("ReceivedMessages")
  visibleToMessages   ChatMessage[]        @relation("VisibleToMessages")
  sentReviews         Review[]             @relation("SentReviews")
  receivedReviews     Review[]             @relation("ReceivedReviews")
  sentRequests        ServiceRequest[]     @relation("SentRequests")
  receivedRequests    ServiceRequest[]     @relation("ReceivedRequests")
  services            ProviderService[]
  notifications       Notification[]
  mutedConversations  MutedConversation[]
  pinnedConversations PinnedConversation[]
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reports             Report[]
  feedbacks           Feedback[]
  adminActions        AdminActionLog[]

  @@map("users")
}

model Report {
  id          String           @id @default(uuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  description String?
  status      ReportStatus     @default(pending)
  createdAt   DateTime       @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reporter    User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@map("reports")
}

model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  fromValue  String?
  toValue    String?
  reason     String?
  createdAt  DateTime @default(now())

  admin      User     @relation(fields: [adminId], references: [id])

  @@index([targetType, targetId])
  @@index([adminId])
  @@map("admin_action_logs")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  message   String
  createdAt DateTime @default(now())
  status    String   @default("open")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model Post {
  id              String   @id @default(uuid())
  title           String
  description     String
  tag             String // "Service" or "Request"
  price           Json
  images          String[]
  hashtags        String[]
  helpCategoryIds String[]
  authorId        String
  status          PostStatus @default(active)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requests     ServiceRequest[]
  chatMessages ChatMessage[]

  @@map("posts")
}

model ProviderService {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  title       String
  description String
  price       Json
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_services")
}

enum ServiceRequestKind {
  service
  response
}

enum ServiceRequestStatus {
  pending
  active
  pending_review
  completed
  cancelled
  declined
}

model ServiceRequest {
  id                    String               @id @default(uuid())
  requesterId           String
  providerId            String
  postId                String?
  kind                  ServiceRequestKind   @default(service)
  status                ServiceRequestStatus @default(active)
  message               String?
  acceptedAt            DateTime?
  completionRequestedAt DateTime?
  completedAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  requester User     @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  provider  User     @relation("ReceivedRequests", fields: [providerId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  reviews   Review[]

  @@map("service_requests")
}

model ChatMessage {
  id         String      @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  postId     String?
  kind       MessageKind @default(text)
  isRead     Boolean     @default(false)
  visibleToId String?
  createdAt  DateTime    @default(now())

  sender    User  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User  @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  visibleTo User? @relation("VisibleToMessages", fields: [visibleToId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([visibleToId])
  @@map("chat_messages")
}

model Review {
  id               String   @id @default(uuid())
  reviewerId       String
  revieweeId       String
  rating           Int // 1-5
  comment          String
  serviceTitle     String?
  serviceRequestId String?
  postId           String?
  createdAt        DateTime @default(now())

  reviewer       User            @relation("SentReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee       User            @relation("ReceivedReviews", fields: [revieweeId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@unique([serviceRequestId])
  @@map("reviews")
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  kind         NotificationKind
  title        String
  body         String
  read         Boolean          @default(false)
  targetId     String?
  targetScreen String?
  data         Json?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model MutedConversation {
  id                  String   @id @default(uuid())
  userId              String
  participantUsername String
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, participantUsername])
  @@map("muted_conversations")
}

model PinnedConversation {
  id                  String   @id @default(uuid())
  userId              String
  participantUsername String
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, participantUsername])
  @@map("pinned_conversations")
}
