datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  user
  provider
  admin
}

enum ExploreCategoryId {
  tutoring
  tech
  design
  career
  campus
}

enum NotificationKind {
  message
  service
  request
  system
}

model Category {
  id          ExploreCategoryId @id
  title       String
  pillLabel   String
  tagline     String
  description String
  imageUrl    String
  accentColor String
  iconName    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  services CategoryService[]
  users    User[]

  @@map("categories")
}

model CategoryService {
  id          String            @id @default(uuid())
  categoryId  ExploreCategoryId
  title       String
  description String
  filterTags  String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_services")
}

model User {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  username      String             @unique
  password      String
  role          UserRole           @default(user)
  avatarUrl     String             @default("")
  bio           String             @default("")
  categoryId    ExploreCategoryId?
  skillTitle    String?
  expertiseTags String[]
  serviceIds    String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  otpCode       String?
  otpExpires    DateTime?

  // Relations
  posts            Post[]
  sentMessages     ChatMessage[]     @relation("SentMessages")
  receivedMessages ChatMessage[]     @relation("ReceivedMessages")
  sentReviews      Review[]          @relation("SentReviews")
  receivedReviews  Review[]          @relation("ReceivedReviews")
  sentRequests     ServiceRequest[]  @relation("SentRequests")
  receivedRequests ServiceRequest[]  @relation("ReceivedRequests")
  services         ProviderService[]
  notifications    Notification[]
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Post {
  id               String   @id @default(uuid())
  title            String
  description      String
  tag              String // "Service" or "Request"
  price            Json
  images           String[]
  hashtags         String[]
  helpCategoryIds  String[]
  authorId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@map("posts")
}

model ProviderService {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String
  title       String
  description String
  price       Json
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_services")
}

model ServiceRequest {
  id          String   @id @default(uuid())
  requesterId String
  providerId  String
  postId      String?
  status      String   @default("pending") // pending, accepted, declined, completed
  message     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User  @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  provider  User  @relation("ReceivedRequests", fields: [providerId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@map("service_requests")
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Review {
  id           String   @id @default(uuid())
  reviewerId   String
  revieweeId   String
  rating       Int // 1-5
  comment      String
  serviceTitle String?
  createdAt    DateTime @default(now())

  reviewer User @relation("SentReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("ReceivedReviews", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  title     String
  body      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
